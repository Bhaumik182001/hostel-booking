# Production Django Environment Variables
SECRET_KEY=production-secure-random-secret-key-replace-me
DEBUG=0
ALLOWED_HOSTS=your-domain.com,ec2-xx-xx-xx-xx.compute-1.amazonaws.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://your-domain.com,https://your-domain.com,http://localhost

# PostgreSQL Database Configuration
DB_NAME=hostel_db
DB_USER=hostel_user
DB_PASSWORD=strong_production_password_here
DB_HOST=db
DB_PORT=5432
